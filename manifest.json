{
  "manifest_version": 3,
  "name": "Pomodoro Alejandro",
  "version": "1.0.0",
  "description": "Custom pomodoro timer for Alejandro",
  "action": {},
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["notifications", "storage", "alarms"],
  "icons": {
    "48": "images/icon-128.png",
    "128": "images/icon-128.png"
  }
}